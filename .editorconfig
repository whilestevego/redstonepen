root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_size = 4
max_line_length = 120
ktlint_code_style = intellij_idea
# Disable ALL ktlint standard formatting rules — ktfmt (via Spotless) owns formatting.
# Re-enable only the pure lint rules that add value beyond what ktfmt already enforces.
ktlint_standard = disabled
ktlint_standard_no-unused-imports = enabled
ktlint_standard_no-empty-class-body = enabled
ktlint_standard_no-unit-return = enabled
ktlint_standard_no-semi = enabled

[*.{gradle,groovy}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.json]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
